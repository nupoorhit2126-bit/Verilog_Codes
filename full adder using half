
module full_adder(a,b,c,sum,cout);
  input a,b,c;
  output sum,cout;
  wire w1,w2,w3;
  
      half_adder ha1(.A(a),.B(b),.S(w1),.C(w2));
      half_adder ha2(.A(w1),.B(c),.S(sum),.C(w3));
  or G1 (cout,w2,w3);
   
endmodule
    
    module half_adder (A,B,S,C);
      input A,B;
      output S,C; 
      
       assign S= A ^ B;
      assign C = A & B;
     
    endmodule
